{
  "name": "posthog/posthog-laravel",
  "description": "PostHog for Laravel",
  "keywords": [
    "posthog",
    "laravel"
  ],
  "homepage": "https://posthog.com/docs/libraries/laravel",
  "version": "0.4.4",
  "license": "MIT",
  "authors": [
    {
      "name": "PostHog",
      "email": "engineering@posthog.com",
      "homepage": "https://posthog.com/"
    }
  ],
  "support": {
    "issues": "https://github.com/PostHog/posthog-php/issues",
    "source": "https://github.com/PostHog/posthog-php/tree/main/packages/laravel",
    "docs": "https://posthog.com/docs/libraries/laravel"
  },
  "require": {
    "php": ">=8.2",
    "posthog/posthog-php": "4.25.1",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/contracts": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0 || ^12.0",
    "laravel/octane": "^2.0",
    "laravel/pennant": "^1.0"
  },
  "suggest": {
    "laravel/pennant": "Use PostHog flags through Laravel Pennant (^1.0)."
  },
  "autoload": {
    "psr-4": {
      "PostHog\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PostHog\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "PostHog\\Laravel\\PostHogServiceProvider"
      ],
      "aliases": {
        "PostHog": "PostHog\\Laravel\\Facades\\PostHog"
      }
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
