APP_NAME="PostHog Laravel Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=single
DB_CONNECTION=sqlite
# Leave DB_DATABASE unset to use database/database.sqlite.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Blank key = no SDK network, including feature flags. Synthetic demo identities only.
POSTHOG_ENABLED=true
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Optional SERVER-ONLY secret for local flag definitions. Never render in HTML.
POSTHOG_SECRET_KEY=
POSTHOG_RELEASE_ID=laravel-example-local
POSTHOG_CONSUMER=lib_curl
POSTHOG_FLAG_CACHE=false
POSTHOG_LOCAL_ONLY=false
POSTHOG_QUEUE_CONTEXT=true

# Independent opt-ins; restart workers after changing configuration.
POSTHOG_COLLECT_REQUESTS=false
POSTHOG_COLLECT_PAGEVIEWS=false
POSTHOG_COLLECT_AUTH=false
POSTHOG_COLLECT_MODELS=false
POSTHOG_COLLECT_DOMAIN=false
POSTHOG_COLLECT_JOBS=false
POSTHOG_COLLECT_COMMANDS=false
POSTHOG_COLLECT_SCHEDULER=false
