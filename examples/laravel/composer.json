{
    "name": "posthog/laravel-example",
    "description": "Runnable server-side PostHog Laravel example",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0 || ^13.0",
        "posthog/posthog-php": "^4.20",
        "posthog/posthog-laravel": "^0.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0",
        "mockery/mockery": "^1.6"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "posthog/posthog-php": "4.20.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../packages/laravel",
            "options": {
                "symlink": true,
                "versions": {
                    "posthog/posthog-laravel": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.2.0"
        }
    }
}
